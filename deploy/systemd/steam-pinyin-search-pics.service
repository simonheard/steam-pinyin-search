[Unit]
Description=Synchronize Steam Simplified Chinese names through anonymous PICS
Requires=docker.service
After=docker.service network-online.target steam-pinyin-search-sync.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/steam-pinyin-search
ExecStart=/usr/bin/flock --nonblock /run/steam-pinyin-search-pics.lock /usr/bin/docker compose --profile tools run --rm pics
ExecStartPost=/usr/bin/curl --fail --silent --show-error http://127.0.0.1:8787/health

